# Replace URL with your Saleor backend. Make sure to keep the slash at the end.
NEXT_PUBLIC_SALEOR_API_URL=https://server.chapchapticket.com/graphql/

# make sure to add it on production for correct canonical URLs
NEXT_PUBLIC_STOREFRONT_URL=https://www.chapchapticket.com

# Token used for fetching channels / channel metadata (AUTHENTICATED_APP).
# Required for operator homepage company profile (logo, slogan, phone, etc.).
# Create an app in Saleor Dashboard → Apps → create token with channel access.
SALEOR_APP_TOKEN=

# Public support contacts (shown on /contactus and compagnies help box)
NEXT_PUBLIC_SUPPORT_PHONE=+225 07 00 00 00 00
NEXT_PUBLIC_SUPPORT_WHATSAPP=2250700000000
